@page "/"

@inject UserSessionService Session
@inject NavigationManager Navigation

@if (!_isAuthenticated)
{
    <div class="hero">

        <div class="hero-title">
            Every finish lives forever.
        </div>

        <div class="hero-description">
            Turn your Strava activities into memories,
            achievements and personal yearbooks.
        </div>

        <div style="margin-top:30px;">
            <a href="/login" class="btn btn-primary">
                Connect with Strava
            </a>
        </div>

        <div style="margin-top:30px; color:#888;">
            ✓ Secure Strava Login<br />
            ✓ Automatic activity import<br />
            ✓ Personalized running insights
        </div>

    </div>
}

@code
{
    private bool _isAuthenticated;

    protected override void OnInitialized()
    {
        var userId = Session.GetCurrentUserId();

        if (userId != null)
        {
            _isAuthenticated = true;

            Navigation.NavigateTo(
                $"/year/{DateTime.Now.Year}",
                true);

            return;
        }

}
}