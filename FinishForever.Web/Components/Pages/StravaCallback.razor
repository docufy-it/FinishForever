@page "/auth/strava-callback"
@using FinishForever.Infrastructure.Services
@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject StravaApiClient StravaApi
@inject ActivitySyncService SyncService
@inject AthleteService AthleteService

<h3>@Message</h3>

@code {

    private string Message = "Autenticazione in corso...";
    private bool _processed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _processed)
            return;

        _processed = true;

        try
        {
            var uri =
                Navigation.ToAbsoluteUri(
                    Navigation.Uri);

            var query =
                Microsoft.AspNetCore.WebUtilities
                    .QueryHelpers.ParseQuery(
                        uri.Query);

            var code = query["code"];

            if (string.IsNullOrWhiteSpace(code))
            {
                Message = "Code non trovato";
                StateHasChanged();
                return;
            }

            var token =
                await StravaApi.ExchangeCodeAsync(
                    code!);

            if (token == null)
            {
                Message = "Token non ottenuto";
                StateHasChanged();
                return;
            }

            Infrastructure.Services.Dtos.StravaAthleteResponse? athlete =
                await StravaApi.GetAthleteAsync(
                    token.AccessToken);

var dbAthlete =
    await AthleteService.GetOrCreateAsync(
        athlete!.Id,
        athlete.Username,
        athlete.FirstName,
        athlete.LastName,
        athlete.Profile,
        athlete.Premium,
        athlete.Summit,
        token.AccessToken,
        token.RefreshToken,
        DateTimeOffset
            .FromUnixTimeSeconds(
                token.ExpiresAt)
            .UtcDateTime);

            var activities =
                await StravaApi.GetAllActivitiesAsync(
                    token.AccessToken);

await SyncService.SyncAsync(
    dbAthlete.Id,
    activities);

            Console.WriteLine(
                $"Activities found: {activities.Count}");

            foreach (var activity in activities.Take(5))
            {
                Console.WriteLine(
                    $"{activity.StartDateLocal:d} - {activity.Name} - {activity.Distance / 1000:N1} km");
            }

            Message =
                $"Benvenuto {athlete?.FirstName} {athlete?.LastName} - Attività trovate: {activities.Count}";
        }
        catch (Exception ex)
        {
            Message = ex.ToString();
        }

        StateHasChanged();
    }
}