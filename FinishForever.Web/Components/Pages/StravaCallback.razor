@page "/auth/strava-callback"

@using FinishForever.Infrastructure.Persistence
@using FinishForever.Infrastructure.Services
@using FinishForever.Web.Services

@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject StravaApiClient StravaApi
@inject StravaAthleteService StravaAthleteService
@inject StravaActivityService StravaActivityService
@inject ApplicationDbContext Db
@inject UserSessionService Session

<h3>@Message</h3>

@code
{
    private string Message = "Autenticazione in corso...";
    private bool _processed;

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender || _processed)
        {
            return;
        }

        _processed = true;

        try
        {
            var uri =
                Navigation.ToAbsoluteUri(
                    Navigation.Uri);

            var query =
                Microsoft.AspNetCore.WebUtilities
                    .QueryHelpers.ParseQuery(
                        uri.Query);

            var code = query["code"];

            if (string.IsNullOrWhiteSpace(code))
            {
                Message = "Code non trovato";
                StateHasChanged();
                return;
            }

            var token =
                await StravaApi.ExchangeCodeAsync(
                    code!);

            if (token == null)
            {
                Message = "Token non ottenuto";
                StateHasChanged();
                return;
            }

            var athlete =
                await StravaApi.GetAthleteAsync(
                    token.AccessToken);

            if (athlete == null)
            {
                Message = "Athlete non trovato";
                StateHasChanged();
                return;
            }

            var dbAthlete =
                await StravaAthleteService
                    .GetOrCreateAsync(
                        athlete,
                        token);

            Session.SignIn(
                dbAthlete.UserId);

            Message = "Import attività in corso...";
            StateHasChanged();

            var importedActivities =
                await StravaActivityService
                    .SyncAsync(
                        dbAthlete.Id);

            Console.WriteLine(
                $"Imported activities: {importedActivities}");

            Navigation.NavigateTo(
                "/dashboard",
                true);
        }
        catch (Exception ex)
        {
            Message = ex.ToString();
            StateHasChanged();
        }
    }
}